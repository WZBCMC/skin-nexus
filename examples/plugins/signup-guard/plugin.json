{
  "name": "signup-guard",
  "version": "1.0.0",
  "hookApi": 2,
  "entrypoint": "index.js",
  "title": "Signup Guard",
  "description": "v2 fail-closed registration guard example",
  "permissions": ["config", "auth:guards"],
  "config": {
    "schema": {
      "type": "object",
      "properties": {
        "blockedDomain": { "type": "string", "title": "Blocked email domain", "default": "blocked.example" },
        "allowMessage": { "type": "string", "title": "Deny message", "default": "该邮箱域名不允许注册" }
      }
    }
  }
}
