{
  "name": "player-notes",
  "version": "1.0.0",
  "hookApi": 2,
  "entrypoint": "index.js",
  "title": "Player Notes",
  "description": "v2 session route + namespaced store + UI page example",
  "permissions": [
    "store:docs",
    "ui:page",
    "ui:assets",
    "http:routes:session"
  ],
  "store": {
    "schemaVersion": 1,
    "collections": {
      "notes": {
        "maxRows": 1000,
        "maxBytes": 65536
      }
    }
  },
  "routes": [
    {
      "method": "GET",
      "path": "/notes",
      "tier": "session"
    },
    {
      "method": "POST",
      "path": "/notes",
      "tier": "session",
      "csrf": true
    }
  ],
  "ui": {
    "assets": "ui/",
    "pages": [
      {
        "id": "notes",
        "path": "/ext/player-notes/notes",
        "area": "user",
        "nav": {
          "label": "Notes"
        },
        "render": {
          "type": "iframe",
          "src": "notes.html"
        },
        "perm": 0
      }
    ],
    "i18n": {
      "zh-CN": {
        "title": "笔记"
      },
      "en": {
        "title": "Notes"
      }
    }
  },
  "minServer": ">=0.3.0",
  "requires": {
    "plugins": {},
    "server": ">=0.3.0"
  }
}
